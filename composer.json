{
  "name": "heller/simple-csv",
  "description": "A package to make working with CSV files as convenient and simple as possible",
  "license": "MIT",
  "authors": [
    {
      "name": "Lukas Heller",
      "email": "dev@lukas-heller.de"
    }
  ],
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "laravel/pint": "^1.29",
    "pestphp/pest": "^4.7",
    "rector/rector": "^2.5"
  },
  "autoload": {
    "psr-4": {
      "Heller\\SimpleCsv\\": "src/"
    }
  },
  "scripts": {
    "test": "pest",
    "lint": "pint",
    "bench": "@php bench.php"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
